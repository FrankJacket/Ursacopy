@inject Repo Repo
@inject ISnackbar Snack
@inject IDialogService Dialogs

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="job.Name" Label="Name" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="job.DestFolder" Label="Folder on the disk" HelperText="Plain folder name, e.g. photos" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField T="string" Value="job.SourceDir" ValueChanged="OnSourceChanged" Label="Source folder (path in the container)" HelperText="e.g. /source" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="job.TargetDir" Label="Disk mount point (path in the container)" HelperText="e.g. /target" /></MudItem>
            <MudItem xs="12">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="Pick">Choose folders...</MudButton>
                    @if (job.IncludeList().Length == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">The whole source folder is copied.</MudText>
                    }
                    else
                    {
                        @foreach (var f in job.IncludeList()) { <MudChip T="string" Size="Size.Small">@f</MudChip> }
                    }
                </MudStack>
                @if (job.Id != 0 && job.IncludeList().Length > 0)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">A folder you untick later is removed from the disk at the next run (into the trash if one is kept).</MudText>
                }
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="int" @bind-Value="job.ScheduleMode" Label="When">
                    <MudSelectItem T="int" Value="@Schedule.Manual">Manual only</MudSelectItem>
                    <MudSelectItem T="int" Value="@Schedule.Daily">Every day at a given time</MudSelectItem>
                    <MudSelectItem T="int" Value="@Schedule.OnPlug">Whenever the disk is connected</MudSelectItem>
                </MudSelect>
            </MudItem>
            @if (job.ScheduleMode == Schedule.Daily)
            {
                <MudItem xs="12" md="6"><MudTimePicker @bind-Time="time" Label="Time of day (server time zone)" /></MudItem>
            }
            else
            {
                <MudItem md="6" xs="0"></MudItem>
            }

            <MudItem xs="12"><MudCheckBox T="bool" @bind-Value="job.MirrorDeletes" Label="Mirror deletions: remove from the disk what no longer exists in the source" /></MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField T="int" @bind-Value="job.RetentionDays" Min="0" Label="Days to keep deleted and replaced files"
                                 HelperText="0 = delete and overwrite right away. Kept in .ursacopy-trash on the disk." />
            </MudItem>
            <MudItem xs="12" md="6"><MudCheckBox T="bool" @bind-Value="job.Verify" Label="Verify each copied file (slower)" /></MudItem>
            <MudItem xs="12">
                <MudCheckBox T="bool" @bind-Value="job.WindowsDisk" Label="The disk is formatted NTFS or exFAT" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Names NTFS / exFAT cannot hold (: * ? " &lt; &gt; | ..., names differing only by case) are reported instead of being copied wrongly,
                    and an exFAT date shifted by whole hours (daylight saving time) is not taken for a change. Untick for an ext4 / XFS / Btrfs disk.
                </MudText>
            </MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="job.Excludes" Label="Exclusions (one per line, wildcards * and ?)" Lines="5" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12"><MudCheckBox T="bool" @bind-Value="job.Enabled" Label="Enabled (scheduled runs happen only when enabled)" /></MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">@(job.Id == 0 ? "Add job" : "Save changes")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    /// <summary>Job to edit; null = new job.</summary>
    [Parameter] public Job? Job { get; set; }

    Job job = new();
    TimeSpan? time = new(2, 0, 0);
    string originalTarget = "";

    protected override void OnInitialized()
    {
        if (Job is not { } j) return;
        job = new Job // edit a copy: Cancel leaves the list untouched
        {
            Id = j.Id, Name = j.Name, SourceDir = j.SourceDir, Includes = j.Includes, TargetDir = j.TargetDir, DestFolder = j.DestFolder, TargetId = j.TargetId,
            Enabled = j.Enabled, ScheduleMode = j.ScheduleMode, DailyTime = j.DailyTime, MirrorDeletes = j.MirrorDeletes,
            RetentionDays = j.RetentionDays, Verify = j.Verify, WindowsDisk = j.WindowsDisk, Excludes = j.Excludes, CreatedUtc = j.CreatedUtc, EstimatedFiles = j.EstimatedFiles, EstimatedBytes = j.EstimatedBytes,
        };
        originalTarget = j.TargetDir;
        time = TimeSpan.TryParse(j.DailyTime, out var t) ? t : new TimeSpan(2, 0, 0);
    }

    void OnSourceChanged(string v)
    {
        if (v != job.SourceDir) job.Includes = ""; // the chosen sub-folders belonged to the previous source
        job.SourceDir = v;
    }

    async Task Pick()
    {
        var root = job.SourceDir?.Trim() ?? "";
        if (root.Length == 0 || !Directory.Exists(root))
        { Snack.Add("Enter an existing source folder first (path as seen in the container).", Severity.Warning); return; }
        var parameters = new DialogParameters<FolderPicker> { { x => x.Root, root }, { x => x.Selected, job.IncludeList().ToList() } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, BackdropClick = false };
        var dialog = await Dialogs.ShowAsync<FolderPicker>("Choose the folders to copy", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: List<string> chosen }) job.Includes = string.Join('\n', chosen);
    }

    void Save()
    {
        job.Name = job.Name?.Trim() ?? "";
        job.DestFolder = job.DestFolder?.Trim() ?? "";
        job.SourceDir = job.SourceDir?.Trim() ?? "";
        job.TargetDir = job.TargetDir?.Trim() ?? "";
        if (job.Name.Length == 0 || job.SourceDir.Length == 0 || job.TargetDir.Length == 0 || job.DestFolder.Length == 0)
        { Snack.Add("Name, source, mount point and folder on the disk are required.", Severity.Warning); return; }
        if (job.DestFolder is "." or ".." || job.DestFolder.StartsWith('.') || job.DestFolder.IndexOfAny(['/', '\\']) >= 0)
        { Snack.Add("The folder on the disk must be a plain name: no slash, not starting with a dot.", Severity.Warning); return; }
        if (job.ScheduleMode == Schedule.Daily)
        {
            if (time is null) { Snack.Add("Pick a time of day.", Severity.Warning); return; }
            job.DailyTime = time.Value.ToString(@"hh\:mm");
        }
        if (job.RetentionDays < 0) job.RetentionDays = 0;
        if (job.Id != 0 && job.TargetDir != originalTarget) job.TargetId = null; // another mount point: the disk has to be initialised again

        Repo.SaveJob(job);
        Snack.Add("Job saved.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(job.Id));
    }
}
